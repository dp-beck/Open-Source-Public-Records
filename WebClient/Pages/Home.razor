@page "/"
@using Data

<PageTitle>Home</PageTitle>

<h1>OpenRecords</h1>

<p >Welcome to OpenRecords, an online resource for information and links related to open-source corporate intelligence
    and legal research.</p>

<h2>Search Resources</h2>
<input/>

<h2>Countries</h2>
<p>List of Countries here -- Clicking on Links will go to new view with available states plus country level resources</p>
<ul>
    @foreach (var country in Countries)
    {
        <li>@country.Name</li>
    }
</ul>

<h2>Categories</h2>
<p>List of Categories here -- Clicking on links will go to new view with list resources that meet that resource category</p>
<ul>
    @foreach (int category in Enum.GetValues(typeof(ResourceType)))
    {
        <li>@Enum.GetName(typeof(ResourceType), category)</li>
    }
</ul>
